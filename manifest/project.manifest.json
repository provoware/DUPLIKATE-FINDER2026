{
  "$schema": "../schemas/project-manifest.schema.json",
  "schema_version": "1.0.0",
  "project": {
    "id": "provoware-duplicate-finder-2026",
    "name": "PROVOWARE DUPLIKATE-FINDER 2026",
    "version": "0.5.0",
    "language": "de-DE"
  },
  "runtime": {
    "python": "3.12.15",
    "gui": "PySide6 6.11.2",
    "tkinter_allowed": false
  },
  "workspace": {
    "environment_variable": "PROVOWARE_PROJECT_DIR",
    "default_relative_to_home": "PROVOWARE/DUPLIKATE-FINDER-2026",
    "required_directories": [
      "data",
      "logs",
      "recovery",
      "quarantine",
      "exports",
      "reports",
      "checkpoints",
      "config"
    ]
  },
  "safety": {
    "original_files": "read_only",
    "system_python_mutation": false,
    "sudo_at_runtime": false,
    "follow_symlinks": false
  },
  "quality": {
    "baseline_window": "800x600",
    "zoom_percent": [
      100,
      150,
      200
    ],
    "full_acceptance_before_merge": true,
    "minimum_acceptance_checks": 77
  },
  "state": {
    "registry": ".provoware-state/development-state.json",
    "error_catalog": ".provoware-state/error-catalog.jsonl",
    "checkpoint_log": ".provoware-state/checkpoints.jsonl"
  },
  "texts": {
    "catalog": "resources/texts/de-DE.v1.json",
    "manifest": "resources/texts/manifest.json"
  },
  "agents": {
    "manifest": "manifest/agents.manifest.json",
    "single_writer_role": "operator"
  },
  "features": {
    "process_control": [
      "pause",
      "resume",
      "cancel",
      "progress_percent",
      "current_step",
      "estimated_remaining_time"
    ],
    "scan_filters": [
      "python_project_directories",
      "file_extensions"
    ],
    "standard_tools": [
      "autosave_5_minutes",
      "virtual_state_export",
      "virtual_state_import",
      "cpu_core_limit"
    ],
    "performance": [
      "virtual_table_models",
      "process_cpu_ram_swap",
      "items_per_second",
      "processed_bytes",
      "byte_weighted_eta"
    ]
  },
  "governance": {
    "frozen_areas": [
      {
        "id": "ui_process_control",
        "name": "Bedienoberfläche / Prozesssteuerung",
        "status": "FROZEN",
        "since_version": "0.5.0",
        "frozen_on": "2026-10-06",
        "scope": [
          "app/gui/**",
          "app/process_control.py",
          "app/progress_format.py",
          "app/resource_monitor.py",
          "app/cpu_limit.py",
          "app/settings_store.py"
        ],
        "allowed_without_reopen": [
          "safety_correction",
          "regression_correction",
          "required_platform_compatibility"
        ],
        "reopen_requires": [
          "explicit_scope_decision",
          "pre_validation",
          "targeted_tests",
          "full_800x600_100_150_200_acceptance",
          "post_validation"
        ]
      }
    ]
  }
}

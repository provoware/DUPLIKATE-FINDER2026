{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "timestamp",
    "fingerprint",
    "area",
    "message",
    "solution",
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "new",
        "resolved",
        "known"
      ]
    }
  }
}
